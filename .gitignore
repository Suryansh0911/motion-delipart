# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output and caches
dist/
out/
.next/
.vinext/
.vite/
.cache/
*.tsbuildinfo
next-env.d.ts

# Test output
coverage/
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and credentials
.env*
!.env.example
!.env.sample
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key

# Cloudflare and deployment state
.wrangler/
.vercel/

# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Editor and operating-system files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
